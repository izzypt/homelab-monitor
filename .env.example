# Copy to .env and fill in. .env is git-ignored: never commit real values.

# Image tag to run (git SHA from CI). "dev" = locally built.
IMAGE_TAG=dev

LOG_LEVEL=INFO
TIMEZONE=Europe/Lisbon

# PostgreSQL
POSTGRES_DB=homelab_monitor
POSTGRES_USER=homelab_monitor
POSTGRES_PASSWORD=change-me

# Redis (broker + sessions)
REDIS_PASSWORD=change-me

# healthchecks.io ping URL for the "homelab-monitor" check (pinged by beat every minute).
# Leave empty to disable.
HEALTHCHECK_PING_URL=

# Email alerts. Leave SMTP_HOST empty until the sender is set up: alerts are then recorded
# but marked failed. ALERT_RECIPIENTS is a comma-separated list.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
ALERT_FROM=
ALERT_RECIPIENTS=

# Warn this many days before a monitored HTTPS certificate expires.
TLS_WARNING_DAYS=14

# Containers are recorded under the host with this name (register it via POST /api/v1/hosts).
DOCKER_HOST_NAME=mac-mini

# Local network outage detection: comma-separated control URLs.
NETWORK_CONTROL_URLS=https://1.1.1.1,https://www.google.com
