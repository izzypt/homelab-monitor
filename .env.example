# Copy to .env and fill in. .env is git-ignored: never commit real values.

# Image tag to run (git SHA from CI). "dev" = locally built.
IMAGE_TAG=dev

LOG_LEVEL=INFO
TIMEZONE=Europe/Lisbon

# PostgreSQL
POSTGRES_DB=homelab_monitor
POSTGRES_USER=homelab_monitor
POSTGRES_PASSWORD=change-me

# Redis (broker + sessions)
REDIS_PASSWORD=change-me

# healthchecks.io ping URL for the "homelab-monitor" check (pinged by beat every minute).
# Leave empty to disable.
HEALTHCHECK_PING_URL=
